# Copy to .env. Never commit .env. Leave the inference key empty to run the deterministic demo.

# Local compose publishes the UI here. On a Vultr VM, use 80 and 443.
HTTP_PORT=8088
HTTPS_PORT=8443
FIXTURES_PORT=8090

# Optional public hostname. Empty keeps plain HTTP. Example: quotes.example.com
DOMAIN=
ACME_EMAIL=
COOKIE_SECURE=false

# Vultr Serverless Inference. OpenAI-compatible.
# auto: live when the key is set, otherwise the deterministic mock.
INFERENCE_MODE=auto
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_PLANNER_MODEL=glm-5.3-flash
VULTR_VISION_MODEL=glm-5.3-flash

# runc is the default. After INSTALL_GVISOR=1, set runsc.
# setup registers runsc with --network=host: the kernel stack inside Docker's
# network namespace, not the host's network. The sandbox stays on the internal network.
SANDBOX_RUNTIME=runc
SANDBOX_MEMORY=1280m
SANDBOX_CPUS=1
SANDBOX_PIDS=512
SANDBOX_TIMEOUT_MS=120000

# Real store links are on for the public demo. Set false to allow only the fixture safety demo.
ALLOW_LIVE_URLS=true
# Public demo: how many comparisons one address may start per window.
RATE_LIMIT_RUNS=6
RATE_LIMIT_WINDOW_MS=3600000

# Optional shared password. Empty leaves the demo open.
DEMO_PASSWORD=
